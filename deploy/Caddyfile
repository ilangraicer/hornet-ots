(hornet_common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
	}

	# No ATAK/iTAK clients: TAK-client APIs and internal hooks are never public
	@blocked path /Marti* /files/* /api/rabbitmq/* /api/certificate* /api/truststore* /api/itak_qr_string* /api/tak_gov* /api/plugins/* /api/packages*
	handle @blocked {
		respond 404
	}

	# Map tiles (PMTiles via HTTP range requests)
	handle /tiles/* {
		header Cache-Control "public, max-age=86400"
		root * /srv
		file_server
	}

	handle /api/* {
		reverse_proxy ots-api:8081
	}
	handle /socket.io/* {
		reverse_proxy ots-api:8081
	}
}

# Web app (hornet-web static build) + API on one origin: cookies and XSRF work without CORS
{$WEB_HOST} {
	import hornet_common

	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://{$WEB_HOST}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

# API host (health checks, tools)
{$API_HOST} {
	import hornet_common

	handle {
		respond 404
	}
}
