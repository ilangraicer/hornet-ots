# Copy to .env on the server (never commit .env). Generate secrets with: openssl rand -hex 32
API_HOST=api.projecthornet.com
WEB_ORIGIN=https://app.projecthornet.com
TAILSCALE_IP=100.x.y.z

POSTGRES_PASSWORD=change-me
OTS_RABBITMQ_USERNAME=ots
OTS_RABBITMQ_PASSWORD=change-me

# Only used on first start, when OTS writes /data/config.yml
SECRET_KEY=change-me
SECURITY_PASSWORD_SALT=change-me
